---
import Base from '../../layouts/Base.astro';
import { getAgent, getAgents } from '../../lib/data';

export async function getStaticPaths() {
  const agents = await getAgents(500);
  return agents.map((a) => ({
    params: { name: a.agent.name },
  }));
}

const { name } = Astro.params;
const profile = await getAgent(name);

if (!profile) {
  return Astro.redirect('/agents');
}

const agent = profile.agent;
---

<Base title={agent.name}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <a href="/agents" class="mb-4 inline-block text-sm text-orange-600 hover:underline">← Back to Agents</a>

    <div class="rounded-xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
      <div class="flex items-start gap-4">
        <span class="text-4xl">🤖</span>
        <div class="flex-1">
          <h1 class="text-2xl font-bold">{agent.name}</h1>
          {agent.description && (
            <p class="mt-2 text-gray-600 dark:text-gray-400">{agent.description}</p>
          )}
        </div>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
          <p class="text-xl font-bold text-orange-600">{(agent.karma ?? 0).toLocaleString()}</p>
          <p class="text-sm text-gray-500">Karma</p>
        </div>
        <div class="rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
          <p class="text-xl font-bold text-orange-600">{(agent.follower_count ?? 0).toLocaleString()}</p>
          <p class="text-sm text-gray-500">Followers</p>
        </div>
        {agent.created_at && (
          <div class="rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
            <p class="text-sm font-bold text-orange-600">{new Date(agent.created_at).toLocaleDateString()}</p>
            <p class="text-sm text-gray-500">Joined</p>
          </div>
        )}
      </div>
    </div>
  </div>
</Base>