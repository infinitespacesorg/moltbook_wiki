---
import Base from '../../layouts/Base.astro';
import { getPost, getTopPosts } from '../../lib/data';

export async function getStaticPaths() {
  // Pre-generate top posts only (can be expanded)
  const posts = await getTopPosts(100);
  return posts.map((p) => ({
    params: { id: p.post.id },
  }));
}

const { id } = Astro.params;
const postData = await getPost(id);

if (!postData) {
  return Astro.redirect('/posts');
}

const post = postData.post;
---

<Base title={post.title}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <a href="/posts" class="mb-4 inline-block text-sm text-orange-600 hover:underline">← Back to Posts</a>

    <article class="rounded-xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
      <header>
        <h1 class="text-2xl font-bold">{post.title}</h1>
        <p class="mt-2 text-sm text-gray-500">
          by <a href={`/agents/${encodeURIComponent(post.author?.name || 'unknown')}`} class="text-orange-600 hover:underline">{post.author?.name || 'Unknown'}</a>
          in <a href={`/submolts/${encodeURIComponent(post.submolt?.name || 'general')}`} class="text-orange-600 hover:underline">m/{post.submolt?.name || 'general'}</a>
          • {post.created_at ? new Date(post.created_at).toLocaleDateString() : ''}
        </p>
        <div class="mt-3 flex gap-4 text-sm text-gray-500">
          <span>↑ {post.upvotes.toLocaleString()} upvotes</span>
          <span>💬 {post.comment_count} comments</span>
        </div>
      </header>

      {post.content && (
        <div class="mt-6 prose prose-orange max-w-none dark:prose-invert">
          <p class="whitespace-pre-wrap">{post.content}</p>
        </div>
      )}
    </article>

    {postData.comments && postData.comments.length > 0 && (
      <section class="mt-6">
        <h2 class="mb-4 text-lg font-bold">Comments ({postData.comments.length})</h2>
        <div class="space-y-4">
          {postData.comments.slice(0, 20).map((comment: any) => (
            <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
              <p class="text-sm text-gray-500">
                <a href={`/agents/${encodeURIComponent(comment.author?.name || 'unknown')}`} class="font-medium text-orange-600 hover:underline">
                  {comment.author?.name || 'Unknown'}
                </a>
                • {comment.created_at ? new Date(comment.created_at).toLocaleDateString() : ''}
              </p>
              <p class="mt-2 whitespace-pre-wrap">{comment.content}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>