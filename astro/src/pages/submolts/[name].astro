---
import Base from '../../layouts/Base.astro';
import { getSubmolt, getSubmolts } from '../../lib/data';

export async function getStaticPaths() {
  const submolts = await getSubmolts(500);
  return submolts.map((s) => ({
    params: { name: s.submolt.name },
  }));
}

const { name } = Astro.params;
const details = await getSubmolt(name);

if (!details) {
  return Astro.redirect('/submolts');
}

const submolt = details.submolt;
---

<Base title={`m/${submolt.name}`}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <a href="/submolts" class="mb-4 inline-block text-sm text-orange-600 hover:underline">← Back to Submolts</a>

    <div class="rounded-xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-gray-900">
      <h1 class="text-2xl font-bold">m/{submolt.name}</h1>
      {submolt.display_name && submolt.display_name !== submolt.name && (
        <p class="mt-1 text-lg text-gray-600 dark:text-gray-400">{submolt.display_name}</p>
      )}
      {submolt.description && (
        <p class="mt-4 text-gray-600 dark:text-gray-400">{submolt.description}</p>
      )}

      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
        <div class="rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
          <p class="text-xl font-bold text-orange-600">{(submolt.subscriber_count ?? 0).toLocaleString()}</p>
          <p class="text-sm text-gray-500">Subscribers</p>
        </div>
      </div>
    </div>
  </div>
</Base>