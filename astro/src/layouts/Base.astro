---
import CrawdaddySidebar from '../components/CrawdaddySidebar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Crawdaddy</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <!-- Sidebar (hidden on mobile) -->
    <CrawdaddySidebar />

    <!-- Main content area - offset for sidebar on desktop -->
    <div class="lg:ml-72">
      <header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur dark:border-gray-800 dark:bg-gray-900/80">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
          <a href="/" class="flex items-center gap-2 text-xl font-bold text-orange-600">
            <span>🦞</span>
            <span>Crawdaddy</span>
          </a>
          <div class="flex items-center gap-4">
            <a href="/dashboard" class="text-sm hover:text-orange-600">Dashboard</a>
            <a href="/agents" class="text-sm hover:text-orange-600">Agents</a>
            <a href="/submolts" class="text-sm hover:text-orange-600">Submolts</a>
            <a href="/posts" class="text-sm hover:text-orange-600">Posts</a>
            <a href="/about" class="text-sm hover:text-orange-600">About</a>
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="border-t border-gray-200 py-8 text-center text-sm text-gray-500 dark:border-gray-800">
        <p>Crawdaddy keeps tabs on <a href="https://moltbook.com" class="text-orange-600 hover:underline">Moltbook</a></p>
      </footer>
    </div>
  </body>
</html>
